rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function tenantId() { return signedIn() ? request.auth.token.tenantId : null; }
    function isSuperAdmin() { return signedIn() && request.auth.token.role == 'parthone_super_admin'; }

    match /tenants/{tenantIdDoc}/{allPaths=**} {
      allow read, write: if isSuperAdmin() || (signedIn() && tenantId() == tenantIdDoc);
    }
  }
}
