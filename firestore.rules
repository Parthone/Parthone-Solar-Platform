rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function role() { return signedIn() ? userDoc().data.role : null; }
    function tenantId() { return signedIn() ? userDoc().data.tenantId : null; }
    function userActive() { return signedIn() && userDoc().data.isActive != false; }
    function tenantDoc(id) { return get(/databases/$(database)/documents/tenants/$(id)); }
    function tenantActive(id) {
      return tenantDoc(id).data.status == 'active' && tenantDoc(id).data.planStatus != 'inactive';
    }
    function isSuperAdmin() { return signedIn() && userActive() && role() == 'parthone_super_admin'; }
    function isClientAdmin() { return signedIn() && userActive() && role() == 'client_admin'; }
    function sameTenant(id) { return signedIn() && userActive() && tenantId() == id; }
    function activeSameTenant(id) { return sameTenant(id) && tenantActive(id); }

    match /tenants/{tenantIdDoc} {
      allow read: if isSuperAdmin() || sameTenant(tenantIdDoc);
      allow create, update, delete: if isSuperAdmin();

      match /{document=**} {
        allow read, write: if isSuperAdmin() || activeSameTenant(tenantIdDoc);
      }
    }

    // Safe public white-label metadata used before authentication.
    match /publicTenantBranding/{tenantIdDoc} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    match /users/{userId} {
      allow read: if isSuperAdmin() ||
        (signedIn() && request.auth.uid == userId) ||
        (isClientAdmin() && activeSameTenant(resource.data.tenantId) && resource.data.tenantId == tenantId());

      allow create: if isSuperAdmin() ||
        (isClientAdmin() && activeSameTenant(request.resource.data.tenantId) &&
         request.resource.data.tenantId == tenantId() &&
         request.resource.data.role != 'parthone_super_admin');

      allow update: if isSuperAdmin() ||
        (isClientAdmin() && activeSameTenant(resource.data.tenantId) &&
         resource.data.tenantId == tenantId() &&
         request.resource.data.tenantId == tenantId() &&
         request.resource.data.role != 'parthone_super_admin');

      allow delete: if isSuperAdmin() ||
        (isClientAdmin() && activeSameTenant(resource.data.tenantId) && resource.data.tenantId == tenantId());
    }

    match /platform/{document=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
